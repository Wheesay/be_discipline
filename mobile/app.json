{
  "expo": {
    "name": "Be Discipline",
    "slug": "be-discipline",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bediscipline",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#173F35",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Be Discipline accesses your photos so you can share activity proof with friends.",
          "cameraPermission": "Be Discipline uses your camera so you can capture activity proof.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#EF6A47",
          "defaultChannel": "discipline-reminders"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#173F35",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
